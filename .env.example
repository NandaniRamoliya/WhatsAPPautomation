# =====================================================================
#  WhatsApp Automation Kit - environment settings
#  Copy this file to ".env" and fill the values. Never commit .env.
#  Everything business-specific (WhatsApp number, token, catalogue,
#  messages, hours...) is entered in the DASHBOARD, not here.
# =====================================================================

# --- Server ---------------------------------------------------------
PORT=3000
# Public HTTPS address of this server (ngrok URL locally, your domain in production).
# Used for webhook URL, payment pages and QR links.
PUBLIC_URL=http://localhost:3000
NODE_ENV=development

# Where the SQLite database, generated secrets and backups live.
DATA_DIR=./data

# --- Security -------------------------------------------------------
# Leave empty to auto-generate (saved in DATA_DIR/secrets.json).
# In production you may set them explicitly. Changing ENCRYPTION_KEY later
# makes stored WhatsApp tokens unreadable (re-enter them in the dashboard).
SESSION_SECRET=
ENCRYPTION_KEY=

# First super-admin login (created on first start if no users exist).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now

# --- Meta / WhatsApp Cloud API (agency-level defaults) ---------------
# Graph API version - check Meta's "API Setup" page for the latest.
GRAPH_VERSION=v24.0
# Token you type in Meta > WhatsApp > Configuration > Webhook > Verify token.
# Leave empty to auto-generate (shown in the dashboard under Settings > WhatsApp).
WA_VERIFY_TOKEN=
# App secret from Meta App > Settings > Basic. Used to verify webhook signatures.
# Can also be set per business in the dashboard (if each client has its own Meta app).
META_APP_SECRET=

# --- Optional: AI understanding of free text (Claude) ----------------
# Lets customers type "2 kilo aata aur 1 maggi" or ask free questions.
# Enable per business in Settings > AI.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# --- Defaults for new businesses ---------------------------------------
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_COUNTRY_CODE=91
DEFAULT_CURRENCY=INR

# --- Scheduler -----------------------------------------------------------
# How often (ms) reminders / follow-ups / broadcasts are processed.
SCHEDULER_INTERVAL_MS=30000
# Set to "false" to disable the scheduler on this instance (e.g. extra web replicas).
SCHEDULER_ENABLED=true
