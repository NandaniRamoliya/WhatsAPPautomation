{
  "name": "replix",
  "version": "1.2.0",
  "description": "Replix by Indrix: ready-to-deliver WhatsApp Cloud API automation kit: ordering, appointments, enquiries, reminders, payments and a no-code dashboard for any business.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "setup": "node --disable-warning=ExperimentalWarning scripts/setup.js",
    "demo": "node --disable-warning=ExperimentalWarning scripts/seed-demo.js",
    "create-admin": "node --disable-warning=ExperimentalWarning scripts/create-admin.js",
    "backup": "node --disable-warning=ExperimentalWarning scripts/backup.js",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"test/*.test.js\"",
    "users": "node --disable-warning=ExperimentalWarning scripts/list-users.js",
    "site:build": "node --disable-warning=ExperimentalWarning scripts/publish-site.js build",
    "site:publish": "node --disable-warning=ExperimentalWarning scripts/publish-site.js publish",
    "tunnel": "node --disable-warning=ExperimentalWarning scripts/tunnel.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.11.0",
    "express": "^5.3.0",
    "htm": "^3.1.1",
    "preact": "^11.2.0",
    "qrcode": "^1.5.4",
    "unpdf": "^2.2.1",
    "zod": "^4.6.7"
  },
  "license": "UNLICENSED"
}
